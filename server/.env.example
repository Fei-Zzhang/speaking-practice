# 复制此文件为 .env 并填入真实值
# 使用 Supabase 云数据库（官网 https://supabase.com 国内一般可访问）

# Supabase 项目地址（在 Supabase 控制台 → Settings → API 里复制）
SUPABASE_URL=https://你的项目id.supabase.co

# Service Role Key（同上，用 service_role 密钥，不要暴露到前端）
SUPABASE_SERVICE_KEY=你的service_role密钥

# 服务端口
PORT=3003

# 前端页面地址（用于 CORS），部署时改成你的前端域名
CORS_ORIGIN=http://localhost:8080

# 教师账号首次注册口令（与学生端分离；勿泄露到前端仓库）
# 在 Supabase 执行 server/supabase-assignments.sql 后，登录教师端需填此口令完成注册
TEACHER_REGISTER_SECRET=请改成随机长字符串

# Python 口语评测（asr-eval、智聆 oral-eval 等；Listen&Repeat 与 Interview 评测共用该服务地址）
PYTHON_BASE_URL=http://localhost:5001

# ---------- 腾讯云「实时语音识别」WebSocket（Interview 题目练习页 · 流式转写）----------
# 与 oral-python-backend/.env 中的 TENCENT_ASR_SECRET_ID / KEY 可相同；AppID 在控制台「API 密钥管理」查看
# 不配则 GET /api/tencent-asr/sign 不可用，不影响 Listen&Repeat
TENCENT_ASR_APP_ID=
# 若与口语评测（智聆）共用同一账号，可填与 TENCENT_APP_ID 相同的 AppID
# TENCENT_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=

# 商业化联调 PoC：设为 1 时启用 /api/poc/*（内存模拟短信 OTP 与支付回调，切勿在生产开启）
# POC_MODE=0
